<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvTagBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="72dp"
        android:layout_marginStart="12dp"
        android:background="#AA000000"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/ic_tag"
        android:visibility="gone"
        android:contentDescription="Tags" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@android:color/white"
        android:background="#66000000"
        app:titleTextColor="@android:color/white" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#66000000"
        android:padding="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/delete"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_delete"
            app:iconTint="@android:color/white"
            app:backgroundTint="#AAE53935"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="@string/rotate"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_rotate"
            app:iconTint="@android:color/white"
            app:backgroundTint="#AA455A64"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="@string/share"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_share"
            app:iconTint="@android:color/white"
            app:backgroundTint="#AA33B5E5"
            style="@style/Widget.Material3.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTag"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="@string/tag"
            android:textColor="@android:color/white"
            app:icon="@drawable/ic_tag"
            app:iconTint="@android:color/white"
            app:backgroundTint="#AAFFA000"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

</FrameLayout>
